# ---------------------------------------------------------------------------
# Event Management Hub — central server configuration
# Copy this file to `.env` (`npm run setup` does it for you) and fill in values.
# NEVER commit a real .env or real secrets.
# ---------------------------------------------------------------------------

# ---- Server ----
PORT=3000
NODE_ENV=development

# Base URL the Android client should use.
#   Android emulator -> http://10.0.2.2:3000   (10.0.2.2 = host loopback)
#   Real device       -> http://<your-LAN-IP>:3000
API_BASE_URL=http://10.0.2.2:3000

# ---- Database (PostgreSQL) ----
# Leave DATABASE_URL EMPTY to use the bundled local PostgreSQL (development only,
# no admin rights required, data lives in ./data/pg).
#
# For a real PostgreSQL server, set it and set USE_EMBEDDED_PG=false:
#   DATABASE_URL=postgres://emh:change-me@localhost:5432/emh
DATABASE_URL=

# Only used when DATABASE_URL is empty.
USE_EMBEDDED_PG=true
EMBEDDED_PG_PORT=5433
EMBEDDED_PG_USER=emh
EMBEDDED_PG_PASSWORD=emh_local_dev
EMBEDDED_PG_DATABASE=emh
# Leave blank for the default: <server>/data/pg
EMBEDDED_PG_DIR=

# ---- Auth ----
# REQUIRED. No default is compiled into the source.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Demo account (development convenience) ----
# The demo account uses a password published in this repository, so it is NOT
# created in production unless you explicitly opt in here.
#   Leave blank -> enabled in development/test, disabled when NODE_ENV=production
SEED_DEMO_USER=

# Required only when SEED_DEMO_USER=true in production. Leave blank to use the
# documented development placeholder (refused when NODE_ENV=production).
DEMO_USER_PASSWORD=

# ---- CORS ----
# Comma-separated allowlist of browser origins. Leave blank to reflect the
# request origin (development default). Set this explicitly in production.
# Native Android clients send no Origin header and are unaffected.
CORS_ORIGINS=

# ---- Misc ----
BCRYPT_ROUNDS=10