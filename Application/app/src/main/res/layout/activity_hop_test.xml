<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/hop_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorPrimary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/hop_relay_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Act as relay node (users as nodes)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Simulator: stage link loss (cut a link to stage 'walked out of range' or a true multi-hop path). Real BLE: read the per-peer RSSI in the stats."
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/hop_link_toggles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Announce a venue (flooded over the mesh, others navigate by it):"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <EditText
                android:id="@+id/hop_venue_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="text"
                android:hint="e.g. Library" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hop_announce_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Announce" />
        </LinearLayout>

        <TextView
            android:id="@+id/hop_directory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/relay_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hop_sim_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Simulated test" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hop_real_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Real test (2+ phones)" />
        </LinearLayout>

        <TextView
            android:id="@+id/hop_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/tx_color" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textColor="@color/relay_color"
            android:text="Real test: give each phone a distinct name (Settings), keep A and C out of range with B in between, send from A. B's stats must show relays ≥ 1 — that is a user acting as a node. Console shows RX/RELAYED/DELIVERED per hop." />

    </LinearLayout>
</ScrollView>
